# CyberWatch Configuration
APP_NAME=CyberWatch
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (optional for Phase 1)
DATABASE_URL=postgresql+asyncpg://cyberwatch:cyberwatch_dev@localhost:5432/cyberwatch

# Monitoring
MONITOR_INTERVAL_SECONDS=5
MAX_CONNECTIONS_HISTORY=10000

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# AI (Phase 5)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=
